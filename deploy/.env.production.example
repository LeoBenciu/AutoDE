BACKUP_RETENTION_DAYS=30
BACKUP_INTERVAL_SECONDS=86400

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
FINOVA_EXTRACTION_LLM_MODEL=gpt-4o-mini-2024-07-18

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1

ANAF_TOKEN_URL=https://logincert.anaf.ro/anaf-oauth2/v1/token
ANAF_ETRANSPORT_BASE_URL=https://api.anaf.ro/test/ETRANSPORT/ws/v1
ANAF_CLIENT_ID=
ANAF_CLIENT_SECRET=

# Google Drive XLSX/Sheet for e-Transport. Use the base64-encoded service-account JSON.
