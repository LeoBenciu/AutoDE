POSTGRES_USER=autoimport
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_DB=autoimport
JWT_SECRET=replace-with-at-least-32-random-bytes

S3_BUCKET=autoimport-documents
S3_ACCESS_KEY=replace-with-a-random-object-storage-user
S3_SECRET_KEY=replace-with-a-long-random-object-storage-password

PUBLIC_HTTP_PORT=8080
# Leave empty for the bundled nginx proxy. Set the public backend origin only
# when the frontend and backend are deployed as separate services.
