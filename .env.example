# --- Database ---
DATABASE_URL=postgresql://autoimport:autoimport@localhost:5432/autoimport

# --- Auth ---
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL_DAYS=30

# --- S3 (MinIO locally) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-central-1
S3_BUCKET=autoimport-documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# --- Extraction worker ---
# Finova requires OpenAI for its account-embedding shortlist and preflight.
# Claude/Gemini/OpenRouter chat extraction additionally needs that provider's
# key when FINOVA_EXTRACTION_LLM_MODEL selects it.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
FINOVA_EXTRACTION_LLM_MODEL=gpt-4o-mini-2024-07-18
FINOVA_EMBEDDING_MODEL=text-embedding-3-small
# Backward-compatible model fallback used when FINOVA_EXTRACTION_LLM_MODEL is unset.
EXTRACTION_MODEL=gpt-4o-mini-2024-07-18
EXTRACTION_CONCURRENCY=2
FINOVA_MAX_CONCURRENT_PHASE0=3
FINOVA_MAX_CONCURRENT_PHASE1=2
PYTHON_BIN=python3
WORKER_DIR=../worker
DATA_EXTRACTION_PYTHON_TIMEOUT_MS=180000
DATA_EXTRACTION_BANK_PYTHON_TIMEOUT_MS=480000

# Finova champion extraction settings.
FINOVA_USE_DIRECT_EXTRACTION=true
FINOVA_VISION_EXTRACTION=true
FINOVA_VISION_ESCALATION=false
FINOVA_VISION_MAX_DIM=2200
FINOVA_VISION_MAX_PAGES=4
FINOVA_VISION_MAX_PAGES_BANK=12
FINOVA_TEXTRACT_ANALYZE=true
FINOVA_TEXTRACT_EXPENSE=false
FINOVA_BANK_CHUNKING=true
FINOVA_BANK_CHUNK_PAGES=1
FINOVA_BANK_CHUNK_CONCURRENCY=6
FINOVA_REPAIR_PASS=false
FINOVA_REPAIR_SCOPED=true
FINOVA_AUTO_ORIENT=true

# Multi-document PDF boundary detection and child-document fan-out.
PENDING_UPLOAD_SPLIT_ENABLED=false
FINOVA_SEGMENT_TIMEOUT_MS=120000
FINOVA_SEGMENT_DPI=100
FINOVA_SEGMENT_MAX_DIM=800
FINOVA_SEGMENT_MAX_PAGES=40
FINOVA_SEGMENT_MIN_CONFIDENCE=0.7

# --- AWS Textract (optional; falls back to text layer + LLM vision) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1

# --- ANAF e-Transport (leave empty until certificate is enrolled) ---
ANAF_TOKEN_URL=https://logincert.anaf.ro/anaf-oauth2/v1/token
ANAF_ETRANSPORT_BASE_URL=https://api.anaf.ro/test/ETRANSPORT/ws/v1
ANAF_CLIENT_ID=
ANAF_CLIENT_SECRET=

# --- Google Drive table used to pre-fill e-Transport by VIN ---
# Share the XLSX/Google Sheet as Viewer with the service-account client_email.
# The credential may be one-line JSON or the base64-encoded JSON key (recommended in production).
ETRANSPORT_DRIVE_FILE_ID=
ETRANSPORT_DRIVE_SHEET_NAME=
ETRANSPORT_DRIVE_CACHE_MS=300000
ETRANSPORT_DRIVE_MAX_BYTES=20971520
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
