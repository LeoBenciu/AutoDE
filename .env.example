# --- Database ---
DATABASE_URL=postgresql://autoimport:autoimport@localhost:5432/autoimport

# --- Auth ---
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL_DAYS=30

# --- S3 (MinIO locally) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-central-1
S3_BUCKET=autoimport-documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# --- Extraction worker ---
ANTHROPIC_API_KEY=
# High-volume/cost-sensitive extraction can use claude-sonnet-4-6
EXTRACTION_MODEL=claude-opus-4-8
EXTRACTION_CONCURRENCY=2
PYTHON_BIN=python3
WORKER_DIR=../worker
# Reject Textract OCR when its text is < this ratio of the PyPDF text layer
OCR_TEXTRACT_MIN_RATIO=0.5
# Per-page character floor below which a PDF page counts as "scanned"
OCR_TEXT_LAYER_MIN_CHARS_PER_PAGE=200

# --- AWS Textract (optional; falls back to text layer + LLM vision) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1

# --- ANAF e-Transport (leave empty until certificate is enrolled) ---
ANAF_TOKEN_URL=https://logincert.anaf.ro/anaf-oauth2/v1/token
ANAF_ETRANSPORT_BASE_URL=https://api.anaf.ro/test/ETRANSPORT/ws/v1
ANAF_CLIENT_ID=
ANAF_CLIENT_SECRET=

# --- Open Banking (leave empty until TPP contract is signed) ---
OPENBANKING_BASE_URL=
OPENBANKING_CLIENT_ID=
OPENBANKING_MTLS_CERT_PATH=
OPENBANKING_MTLS_KEY_PATH=
PIS_BASE_URL=
