{
  "name": "autoimport-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "test:accounting": "ts-node -r tsconfig-paths/register test/accounting-saga.integration.ts",
    "test:etransport": "ts-node -r tsconfig-paths/register test/etransport.spec.ts",
    "test:saga-golden": "ts-node -r tsconfig-paths/register test/saga-golden.spec.ts",
    "test:saga-regressions": "ts-node -r tsconfig-paths/register test/saga-regressions.spec.ts",
    "test:roles": "ts-node -r tsconfig-paths/register test/roles.spec.ts",
    "test:vehicle-line": "ts-node -r tsconfig-paths/register test/vehicle-purchase-line.spec.ts",
    "test:http": "ts-node -r tsconfig-paths/register test/http-acceptance.e2e.ts",
    "test:extraction:live": "ts-node -r tsconfig-paths/register test/live-extraction.acceptance.ts",
    "test:seed-ui": "ts-node -r tsconfig-paths/register test/seed-ui-acceptance.ts",
    "test": "npm run test:roles && npm run test:etransport && npm run test:saga-golden && npm run test:saga-regressions && npm run test:vehicle-line && npm run test:accounting && npm run test:http",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/schedule": "^4.1.1",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "jszip": "^3.10.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.15.1",
    "prisma": "^5.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.13.8",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3"
  }
}
